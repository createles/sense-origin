<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 600">
  <defs>
    <linearGradient id="bagGradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#b98b58" />
      <stop offset="20%" stop-color="#d0a674" />
      <stop offset="80%" stop-color="#d0a674" />
      <stop offset="100%" stop-color="#a87b4a" />
    </linearGradient>
    
    <linearGradient id="sealGradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#a87b4a" />
      <stop offset="50%" stop-color="#c59b68" />
      <stop offset="100%" stop-color="#a87b4a" />
    </linearGradient>
  </defs>

  <ellipse cx="200" cy="540" rx="110" ry="15" fill="rgba(0,0,0,0.15)" />

  <path d="M 90 90 L 310 90 L 325 530 Q 200 550 75 530 Z" fill="url(#bagGradient)" />
  
  <rect x="90" y="50" width="220" height="40" rx="4" fill="url(#sealGradient)" />
  <line x1="95" y1="80" x2="305" y2="80" stroke="#8a6136" stroke-width="2" stroke-dasharray="4,2" />
  
  <path d="M 90 65 A 5 5 0 0 1 95 70 A 5 5 0 0 1 90 75 Z" fill="#ffffff" />
  <path d="M 310 65 A 5 5 0 0 0 305 70 A 5 5 0 0 0 310 75 Z" fill="#ffffff" />

  <g fill="#4a2c11" font-family="Arial, sans-serif" font-weight="900" text-anchor="middle">
    <text x="200" y="145" font-size="32" letter-spacing="4">SENSE</text>
    <text x="200" y="180" font-size="38" letter-spacing="3">ORIGIN</text>
  </g>
  
  <path d="M 100 115 L 140 115 M 260 115 L 300 115" stroke="#4a2c11" stroke-width="3" stroke-linecap="round"/>
  <path d="M 100 215 L 140 215 M 260 215 L 300 215" stroke="#4a2c11" stroke-width="3" stroke-linecap="round"/>

  <g stroke="#4a2c11" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none">
    <path d="M 185 240 Q 170 220 185 200" />
    <path d="M 215 240 Q 230 215 215 190" />
    <path d="M 200 235 Q 190 215 200 195" />
    
    <path d="M 245 285 C 275 285, 275 325, 235 320" />
    
    <ellipse cx="200" cy="345" rx="55" ry="12" />
    
    <path d="M 145 275 C 145 345, 255 345, 255 275 Z" fill="url(#bagGradient)" />
    
    <ellipse cx="200" cy="275" rx="55" ry="15" fill="#d0a674" />
    <ellipse cx="200" cy="275" rx="45" ry="10" fill="#4a2c11" stroke="none" />
    
    <g transform="translate(200, 310) rotate(-25) scale(0.8)">
      <ellipse cx="0" cy="0" rx="10" ry="16" fill="#4a2c11" stroke="none" />
      <path d="M -4 -12 Q 6 0 -4 12" stroke="#d0a674" stroke-width="2" fill="none" />
    </g>
  </g>

  <g fill="#4a2c11">
    <g transform="translate(120, 240) rotate(45) scale(0.5)">
      <ellipse cx="0" cy="0" rx="10" ry="16" />
      <path d="M -4 -12 Q 6 0 -4 12" stroke="#d0a674" stroke-width="2" fill="none" />
    </g>
    <g transform="translate(280, 260) rotate(-15) scale(0.5)">
      <ellipse cx="0" cy="0" rx="10" ry="16" />
      <path d="M -4 -12 Q 6 0 -4 12" stroke="#d0a674" stroke-width="2" fill="none" />
    </g>
    <g transform="translate(130, 330) rotate(-60) scale(0.6)">
      <ellipse cx="0" cy="0" rx="10" ry="16" />
      <path d="M -4 -12 Q 6 0 -4 12" stroke="#d0a674" stroke-width="2" fill="none" />
    </g>
    <g transform="translate(270, 350) rotate(70) scale(0.4)">
      <ellipse cx="0" cy="0" rx="10" ry="16" />
      <path d="M -4 -12 Q 6 0 -4 12" stroke="#d0a674" stroke-width="2" fill="none" />
    </g>
  </g>

  <rect x="110" y="390" width="180" height="40" rx="6" fill="none" stroke="#4a2c11" stroke-width="3" />
  <rect x="115" y="395" width="170" height="30" rx="3" fill="none" stroke="#4a2c11" stroke-width="1" />
  <text x="200" y="416" fill="#4a2c11" font-family="Arial, sans-serif" font-weight="bold" font-size="18" text-anchor="middle" letter-spacing="1">
    <%= coffee.origin_name.length > 12 ? coffee.origin_name.substring(0, 12) + '...' : coffee.origin_name %>
  </text>
  
  <rect x="110" y="445" width="180" height="40" rx="6" fill="none" stroke="#4a2c11" stroke-width="3" />
  <rect x="115" y="450" width="170" height="30" rx="3" fill="none" stroke="#4a2c11" stroke-width="1" />
  <text x="200" y="471" fill="#4a2c11" font-family="Arial, sans-serif" font-weight="bold" font-size="12" text-anchor="middle" letter-spacing="1">
    <%= coffee.name.length > 18 ? coffee.name.substring(0, 18) + '...' : coffee.name %>
  </text>

</svg>